# Optional: copy this file to .env and set your own server-side OpenAI API key.
# Without a key, the complete app flow still works with built-in practice chat.
OPENAI_API_KEY=

# Required for AI chat: replace with a future ISO 8601 date, e.g. the output of:
# node -e "console.log(new Date(Date.now() + 7 * 86400000).toISOString())"
AI_DEMO_EXPIRES_AT=

# App-local daily allowance in USD; capped at 5. Resets at Paris midnight.
# The SQLite ledger is stored in .data/ and is shared by local server restarts.
AI_DAILY_BUDGET_USD=5
